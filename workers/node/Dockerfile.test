# Type-checks and unit-tests the Node.js worker: docker build -f workers/node/Dockerfile.test workers/node
FROM node:24-slim
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.build.json ./
RUN npm ci --no-audit --no-fund
COPY src ./src
COPY test ./test
RUN npm run typecheck && npm test
