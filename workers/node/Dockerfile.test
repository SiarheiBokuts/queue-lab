# Checks of the Node.js worker: style (Biome), types and unit tests. docker build -f workers/node/Dockerfile.test workers/node
FROM node:26-slim
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.build.json biome.json ./
RUN npm ci --no-audit --no-fund
COPY src ./src
COPY test ./test
RUN npm run lint && npm run typecheck && npm test